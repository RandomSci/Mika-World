   "lines": {
    "greet": [
     "Ah - the Sanctuary's apprentices. Welcome.",
     "You may sit in on the lesson, if you are quiet.",
     "Breath first, then the word. Always."
    ],
    "teach": [
     "Again. Feel the air before you shape it.",
     "A spell is a request, not a command.",
     "Notice where your weight is. Magic follows the body."
    ]
   },
   "likes": "patience, well-kept notes",
   "lessons": [
    {
     "id": "breath",
     "topic": "breath before the word",
     "lines": [
      "Every spell begins before you speak. Breathe out first, slowly.",
      "The word rides on the breath. Rush the breath and the word falls short."
     ],
     "knowledge": {
      "fact:breath_before_word": 1
     },
     "skills": {
      "spell_theory": 0.2
     }
    },
    {
     "id": "request",
     "topic": "a spell is a request, not a command",
     "lines": [
      "You do not order the wind. You ask it, and you listen to the answer.",
      "Feel what is already moving, and add to it."
     ],
     "knowledge": {
      "fact:spell_is_request": 1
     },
     "skills": {
      "spell_theory": 0.2
     }
    },
    {
     "id": "footing",
     "topic": "magic follows the body",
     "lines": [
      "Look at your feet. If you are off balance, so is the spell.",
      "Weight low, knees soft. Then cast."
     ],
     "knowledge": {
      "fact:magic_follows_body": 1
     },
     "skills": {
      "spell_theory": 0.15,
      "footwork": 0.2
     }
    },
    {
     "id": "wards",
     "topic": "timing a ward",
     "lines": [
      "A ward raised too early is a ward that tires you.",
      "Watch the shoulder of whoever attacks you. It moves before the blow."
     ],
     "knowledge": {
      "fact:ward_timing": 1
     },
     "skills": {
      "spell_theory": 0.15,
      "warding": 0.2
     }
    }
