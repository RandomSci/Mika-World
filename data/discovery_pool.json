{
 "_note": "Day 3 dynamic discoveries (scripts/world/discovery_director.gd). Not placed in advance: when the director decides a find happens (about one an hour on average, more off the paths, in unexplored corners, in a new area, at night, in rain; less on the home dais), it picks a template for the region she is in and the rarity it rolled, and sets the real thing down a few metres from her, off the path, on walkable ground. Every find is saved (revisitable, on the overlay), gives its reward, and both mages react. regions: area regions from data/world.json, or '*'. repeatable: may come again (a different plant, another spirit) once out of the recent memory; otherwise once ever. requires: knowledge she must already hold (the Phoenix path's clues).",
 "tiers": {
  "common": 0.6,
  "uncommon": 0.28,
  "rare": 0.1,
  "legendary": 0.02
 },
 "rate": {
  "per_hour": 1.25,
  "min_gap_min": 14.0,
  "pity_after_min": 85.0,
  "mult": {
   "off_path": 1.5,
   "unexplored": 1.4,
   "new_area": 1.5,
   "night": 1.25,
   "rain": 1.2,
   "home_core": 0.45,
   "lost": 2.5
  }
 },
 "kind_defaults": {
  "hidden_place": {
   "prop": "cleft",
   "verb": "explore",
   "gesture": "look_around",
   "duration": 7,
   "notice": {
    "mika": [
     "Wait - there's a gap in the rocks there. Was that always there?",
     "Huh. A little hollow, tucked out of sight..."
    ],
    "luna": [
     "There. Behind that - a hidden way. Look.",
     "Someone meant this place not to be found."
    ]
   },
   "react": {
    "mika": [
     "A hidden place! We have to remember this one.",
     "Look how sheltered it is in here - like the world kept a secret."
    ],
    "luna": [
     "Hidden for a reason, I think. Now it's ours.",
     "Mark it. We're coming back."
    ]
   }
  },
  "scenery": {
   "prop": "vista",
   "verb": "observe",
   "gesture": "",
   "duration": 8,
   "notice": {
    "mika": [
     "Oh - come look at this view.",
     "Wait, wait. Look at the light over there."
    ],
    "luna": [
     "Stop a moment. This is worth seeing.",
     "Hm. Now that is a view."
    ]
   },
   "react": {
    "mika": [
     "I want to remember it exactly like this.",
     "It's so quiet up here. Just... beautiful."
    ],
    "luna": [
     "Worth the walk.",
     "Some places don't need a spell to be magic."
    ]
   }
  },
  "plant": {
   "prop": "plant",
   "verb": "collect",
   "gesture": "pick_floor",
   "duration": 5,
   "notice": {
    "mika": [
     "Ooh, something's glowing in the grass!",
     "Look, look - I've never seen a flower like that."
    ],
    "luna": [
     "That bloom isn't in any herbal I've read.",
     "Careful where you step - there's something growing there."
    ]
   },
   "react": {
    "mika": [
     "Got it - and it's still glowing in my hand!",
     "I'm pressing this one in my journal."
    ],
    "luna": [
     "A good specimen. It'll keep.",
     "The alchemists would pay well for this. We won't sell it."
    ]
   }
  },
  "spirit": {
   "prop": "wisp",
   "verb": "commune",
   "gesture": "",
   "duration": 8,
   "notice": {
    "mika": [
     "Do you see that light? It's... moving on its own.",
     "A spirit! A little one - don't scare it."
    ],
    "luna": [
     "Quiet. There's a spirit here.",
     "That light is watching us."
    ]
   },
   "react": {
    "mika": [
     "It touched my hand. It was warm!",
     "It showed me something - I think it trusts us now."
    ],
    "luna": [
     "It remembers this place from long ago.",
     "Gentle thing. It wanted to be seen."
    ]
   }
  },
  "lost_soul": {
   "prop": "wisp",
   "verb": "comfort",
   "gesture": "",
   "duration": 9,
   "notice": {
    "mika": [
     "Someone's there... a lost soul, I think.",
     "Oh no, it looks so sad. Hello?"
    ],
    "luna": [
     "A lost one. It can't find its way.",
     "That's not a wisp. That was a person, once."
    ]
   },
   "react": {
    "mika": [
     "I think we helped it find the way home.",
     "It's gone now... but it looked happier."
    ],
    "luna": [
     "Rest now. You're not lost any more.",
     "We did right by it."
    ]
   }
  },
  "monster": {
   "prop": "lair",
   "verb": "inspect",
   "gesture": "look_around",
   "duration": 7,
   "notice": {
    "mika": [
     "Those tracks are huge. Something big lives here.",
     "Shh - that's a nest. Or a den."
    ],
    "luna": [
     "Fresh tracks. Stay close.",
     "Something rare made this. I want to know what."
    ]
   },
   "react": {
    "mika": [
     "Now we know what lives out here!",
     "I'm glad it wasn't home. I think."
    ],
    "luna": [
     "We'll know it when we meet it.",
     "Rare beast. Worth recording."
    ]
   }
  },
  "rare_item": {
   "prop": "glint",
   "verb": "collect",
   "gesture": "pick_floor",
   "duration": 5,
   "notice": {
    "mika": [
     "Something just glinted down there!",
     "Wait - what's shining in the grass?"
    ],
    "luna": [
     "There's something in the earth there. Catching the light.",
     "Don't move. Look down - left of you."
    ]
   },
   "react": {
    "mika": [
     "Look at it! This is ancient, isn't it?",
     "I can't believe it was just lying there."
    ],
    "luna": [
     "Old work. Very old.",
     "Keep that safe. Things like this have stories."
    ]
   }
  },
  "lore": {
   "prop": "stele",
   "verb": "read",
   "gesture": "",
   "duration": 8,
   "notice": {
    "mika": [
     "There's writing on that stone!",
     "Someone carved something here, a long time ago."
    ],
    "luna": [
     "An inscription. Half buried.",
     "Let me see that stone."
    ]
   },
   "react": {
    "mika": [
     "So that's what happened here...",
     "Every stone in this world has a story, I swear."
    ],
    "luna": [
     "History, written where no one would read it. Until now.",
     "That explains a lot."
    ]
   }
  },
  "phoenix_clue": {
   "prop": "shrine",
   "verb": "inspect",
   "gesture": "look_around",
   "duration": 8,
   "notice": {
    "mika": [
     "Is that... ash? Warm ash, out here?",
     "Look - a feather. It's still glowing!"
    ],
    "luna": [
     "Ember marks. Fire passed through here.",
     "That's the old hearth sign. The Keepers' fire."
    ]
   },
   "react": {
    "mika": [
     "The Ember Keeper was here. I just know it.",
     "Another sign of her... we're getting closer."
    ],
    "luna": [
     "The fire's trail goes on. We follow it.",
     "She left this for someone. Maybe for us."
    ]
   }
  }
 },
