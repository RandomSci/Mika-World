extends RefCounted
## The gesture director's pass or fail table (Selwyn's body pass step 5): every spell of both girls (all 18 spell
## gestures) and every ultimate, cast through the GestureDirector, each standing and (spells) while she walks, and
## once with a blow landing in her gather. Per cast the director logs its own row; this test judges each against the
## rules and prints one line per gesture:
##   face     her facing within 15 deg of where the hand must point when the gather starts
##   plant    standing, a full body gesture: both feet under 5 cm/s when the gather starts
##   upper    walking: the gesture played on her upper body only
##   pace     0.85 to 1.15 of the source (ultimates exactly the source)
##   aim      the casting forearm within 30 deg of the line to the target at the release (gestures that release
##            away from her target by design, the bow arm, the iaido, have their own aim: judged against it)
##   stagger  a blow in her gather gives a stagger, never the small flinch
##   blend    in over 0.15 s, out over 0.2 s (the deck's fades)
## Marks "[gtable] <row json>" and writes docs/GESTURE_TABLE.md. Options --who=mika,luna, --only=<spell>, --no-walk,
## --no-hit, --no-ult. --film: a fixed three quarter camera on the caster for every case (marks "[gfilm] <spell> <case>
## from frame A to frame B"). --trace: the caster's final hand positions and finger curl every frame of each standing
## cast ("[gtrace] <clip> <t> lx ly lz rx ry rz lcurl rcurl", world metres and degrees), for the principles check.

const AIM_OK := 35.0
## The gestures that release AT the target from the hand (a push, a point, a throw, a shot): the aim rule applies to
## them. Area spells (meteors, sky, domains, pillars, rows, seals on the ground, barriers, arrays, spins) land where
## they land; their arms are not aimed.
const AIMED := ["finger_snap_point", "sign_weave_fast", "orb_gather", "spear_conjure_throw", "arm_sweep_wave", "bow_draw_release",
	"seal_finish", "ult_twin_hand_sigil", "ult_heaven_spear", "ult_thousand_palms", "ult_star_archer", "ult_duo_hand_join_push",
	"ult_final_seal_bow", "ult_moon_crescent_cleave"]


static func run(t) -> void:
	var main = t.main
	await t._hold_all()
	await t._force_luna_l1()
	for w in main.mage_brains:
		main.mage_brains[w].set_enabled(false)
	main.director.enabled = false
	main.spawner.enabled = false
	if main.performance:
		main.performance.set_process(false)
	for id in main.characters:
		if not (id in ["mika", "luna"]):
			(main.characters[id] as Node3D).visible = false
	FightDirector.set_hour(main, 13.0)
	await t._wait(1.5)
	var d := FightDirector.new()
	main.add_child(d)
	d.setup(main, "duel", {"seed": 21, "axis_deg": 0.0, "bare": true})
	var sim := MeleeSim.make(d, {"seed": 21, "length": 9999.0, "demo": true})
	d.set_process(true)
	await t.get_tree().process_frame
	sim.start()
	await t.get_tree().process_frame
	var gd: GestureDirector = sim.gestures
	t._check(gd != null, "the gesture director runs in the sim (LimboAI)")
	if gd == null:
		return
	var whos := String(RenderProfile.options.get("who", "mika,luna")).split(",", false)
	var only := String(RenderProfile.options.get("only", ""))
	var rows := []
	for who in whos:
		var other := "luna" if who == "mika" else "mika"
		sim.S[other].p.late = 1.0
		for spell in SpellBook.spells_of(who):
			if only != "" and spell != only:
				continue
			var sp: Dictionary = SpellBook.SPELLS[spell]
			var cases := ["stand"]
			if not RenderProfile.options.has("no-walk") and String(sp.kind) != "barrier":
				cases.append("walk")
			if not RenderProfile.options.has("no-hit") and String(sp.kind) != "barrier":
				cases.append("hit")
			for cs in cases:
				var r := await _one(t, d, sim, gd, who, other, spell, {}, cs)
				rows.append(r)
		if not RenderProfile.options.has("no-ult"):
			for u in MoveCatalog.ULTIMATES:
				var owner := String(MoveCatalog.ULTIMATES[u].get("owner", "mika"))
				if (owner == "luna") != (who == "luna") or (only != "" and u != only):
					continue
				var r2 := await _one(t, d, sim, gd, who, other, u, UltimateCast.spell(u, who), "stand")
				rows.append(r2)
	# the table
	var md := PackedStringArray(["# Gesture table (gesture director, LimboAI)", "",
		"Generated by the gesture_table test. Rules face 15 deg, plant under 5 cm per s, upper body while walking, pace 0.85 to 1.15, aim within %d deg of the line to the target at the release, a blow in the gather gives a stagger, blend in 0.15 s and out 0.2 s." % int(AIM_OK), "",
		"| girl | spell | gesture | case | face | plant or upper | pace | aim | stagger | result |", "|---|---|---|---|---|---|---|---|---|---|"])
	var passed := 0
	for r in rows:
		md.append("| %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |" % [r.who, r.spell, r.clip, r.case, r.face, r.plant, r.pace, r.aim, r.stagger, "PASS" if r.ok else "FAIL " + String(r.why)])
		if r.ok:
			passed += 1
	var f := FileAccess.open("res://docs/GESTURE_TABLE.md", FileAccess.WRITE)
	if f:
		f.store_string("\n".join(md) + "\n")
		f.close()
	t._check(rows.size() > 0, "%d casts judged, %d pass" % [rows.size(), passed])
	t._check(passed == rows.size(), "every gesture passes its rules (%d of %d)" % [passed, rows.size()])
	sim.teardown()
	d.teardown()


static func _one(t, d: FightDirector, sim: MeleeSim, gd: GestureDirector, who: String, other: String, spell: String, over: Dictionary, cs: String) -> Dictionary:
	var sp: Dictionary = over if not over.is_empty() else SpellBook.SPELLS[spell]
	var r0: Array = sp.get("range", [3.0, 6.0])
	var gap := clampf((float(r0[0]) + float(r0[1])) * 0.5, float(r0[0]) + 0.1, 5.5) if over.is_empty() else 4.5
	var c0: Vector3 = d.center
	var sgn := -1.0 if who == "mika" else 1.0
	d.F[who].pos = c0 + Vector3(gap * 0.5 * sgn, 0, 0)
	d.F[other].pos = c0 - Vector3(gap * 0.5 * sgn, 0, 0)
	for id in sim.S:
		sim.S[id].glide = {}
		sim.S[id].vel = Vector3.ZERO
		sim.S[id].state = "free"
		sim.S[id].energy = 100.0
		sim.S[id].next_at = sim.t + 99.0            # (the sim's own choices wait: only this cast)
	await t._wait(0.5)
	for id in sim.F:
		(sim.F[id] as MeleeFighter).replant()
	await t._wait(0.3)
	if RenderProfile.options.has("film"):
		var gy := FightDirector.ground_y(d.F[who].c, c0)
		var caster: Vector3 = d.F[who].pos
		var tgt_p: Vector3 = d.F[other].pos
		var fw := Vector3(tgt_p.x - caster.x, 0, tgt_p.z - caster.z).normalized()
		var sd := fw.cross(Vector3.UP).normalized()
		d.cut(d.ft + 0.001, "fixed", who, {"pos": Vector3(caster.x, gy + 1.35, caster.z) + fw * 2.4 + sd * 3.2,
			"look": Vector3(caster.x, gy, caster.z).lerp(Vector3(tgt_p.x, gy, tgt_p.z), 0.25) + Vector3.UP * 1.1, "fov": 48.0})
	var f0 := Engine.get_frames_drawn()
	var tr: TraceTap = null
	if RenderProfile.options.has("trace") and cs == "stand":
		tr = TraceTap.new()
		tr.name = "TraceGesture"
		tr.clip = String(sp.clip)
		tr.sim = sim
		(sim.F[who] as MeleeFighter).sk.add_child(tr)
	if cs == "walk":
		# she walks across while casting (sideways to her target, so the facing still holds)
		d.move(who, (d.F[who].pos as Vector3) + Vector3(0, 0, 2.2), 2.4, Tween.TRANS_LINEAR, Tween.EASE_IN_OUT)
		await t._wait(0.25)
	var n0 := gd.log.size()
	var ok_req := gd.request(sim.S[who], sim.S[other], spell, over)
	if cs == "hit" and ok_req:
		# a blow lands in her gather: the same path a real hit takes (interrupt, then the reaction)
		var w1: float = t._game_t
		while t._game_t - w1 < 4.0:
			await t.get_tree().process_frame
			if gd.st.has(who) and String(gd.st[who].phase) == "gather" and sim.t >= float(gd.st[who].get("t_g0", INF)) + 0.05:
				break
		var dir := MeleeSim._flat(d.pos(who) - d.pos(other)).normalized()
		sim._interrupt(sim.S[who])
		sim.S[who].last_reaction = HitReactions.hit(sim, sim.S[who], "chest", dir, 0.5, {"weight": "light", "dmg": 1.0})
	var w0: float = t._game_t
	while gd.log.size() == n0 and t._game_t - w0 < 9.0:
		await t.get_tree().process_frame
	await t._wait(0.5)
	if tr:
		tr.queue_free()
	if RenderProfile.options.has("film"):
		print("[gfilm] %s %s from frame %d to frame %d" % [spell, cs, f0, Engine.get_frames_drawn()])
	var row: Dictionary = gd.log[n0] if gd.log.size() > n0 else {}
	var g := GestureBook.of(String(sp.clip))
	var out := {"who": who, "spell": spell, "clip": String(sp.clip), "case": cs, "ok": true, "why": ""}
	var why := PackedStringArray()
	if row.is_empty():
		why.append("no row")
	var fe := float(row.get("face_err_at_gather", -1.0))
	out.face = "%.0f" % fe if fe >= 0.0 else "n/a"
	var ult := bool(sp.get("ultimate", false))
	# (an ultimate's gather starts with its eyes close up: it turns during it, judged by its aim at the release)
	if cs != "hit" and not ult and (fe < 0.0 or fe > GestureDirector.FACE_DEG):
		why.append("face %.0f" % fe)
	if cs == "walk":
		out.plant = "upper" if String(row.get("use", "")) == "upper" else String(row.get("use", "?"))
		if String(row.get("use", "")) != "upper":
			why.append("not upper while walking")
	elif String(g.get("use", "body")) == "body" and cs == "stand":
		var fv := float(row.get("feet_at_plant", 9.0))       # (planted when the gesture starts; the clip may step after)
		out.plant = "%.2f m/s" % fv
		if fv > 0.05 and not ult:
			why.append("feet %.2f" % fv)
	else:
		out.plant = "upper clip"
	var pc := float(row.get("pace", 0.0))
	out.pace = "%.2f" % pc
	if ult and absf(pc - float(g.speed)) > 0.001:
		why.append("ult pace")
	elif not ult and (pc < 0.85 - 1e-4 or pc > 1.15 + 1e-4):
		why.append("pace")
	if cs != "hit":
		var ae := float(row.get("aim_err", -1.0))
		out.aim = ("%.0f" % ae if ae >= 0.0 else "n/a") if String(sp.clip) in AIMED else "area"
		if String(sp.clip) in AIMED and (ae < 0.0 or ae > AIM_OK):
			why.append("aim %.0f" % ae)
		out.stagger = ""
	else:
		out.aim = ""
		out.stagger = String(row.get("reaction", "?"))
		if String(row.get("end", "")) != "staggered" or String(row.get("reaction", "")) != "stagger":
			why.append("hit gave %s %s" % [row.get("end", "?"), row.get("reaction", "?")])
	out.ok = why.is_empty()
	out.why = ", ".join(why)
	print("[gtable] %s" % JSON.stringify(out))
	return out


## (--trace) her final pose each frame: both hands' world positions and each hand's summed finger curl.
class TraceTap extends SkeletonModifier3D:
	var clip := ""
	var sim: MeleeSim
	var _t0 := -1.0

	func _process_modification() -> void:
		var sk := get_skeleton()
		if _t0 < 0.0:
			_t0 = sim.t
		var g := sk.global_transform
		var L: Vector3 = g * sk.get_bone_global_pose(sk.find_bone("LeftHand")).origin
		var R: Vector3 = g * sk.get_bone_global_pose(sk.find_bone("RightHand")).origin
		var curl := {"Left": 0.0, "Right": 0.0}
		for side in curl:
			for fn in ["Index", "Middle", "Ring", "Little"]:
				for seg in ["Proximal", "Intermediate"]:
					var bi := sk.find_bone(side + fn + seg)
					if bi >= 0:
						var q := sk.get_bone_rest(bi).basis.get_rotation_quaternion().inverse() * sk.get_bone_pose_rotation(bi)
						curl[side] = float(curl[side]) + rad_to_deg(q.get_angle())
		print("[gtrace] %s %.3f %.3f %.3f %.3f %.3f %.3f %.3f %.1f %.1f" % [clip, sim.t - _t0, L.x, L.y, L.z, R.x, R.y, R.z, curl.Left, curl.Right])
