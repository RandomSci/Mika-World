   "mood": "latin",
   "why": "incantation",
   "model": "gemini-3.8-flash-tts"
  },
  "0f604e09593becaa96d484be5ad36b7ce19a26b5": {
   "text": "Spiritus venti, fla!",
   "mood": "latin",
   "why": "incantation",
   "model": "gemini-3.8-flash-tts"
  },
  "575f56fb4456ef900b39527c1cd34471fa2a93fa": {
