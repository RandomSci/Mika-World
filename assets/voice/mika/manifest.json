   "why": "incantation",
   "model": "gemini-3.8-flash-tts"
  },
  "e2f03924f2321b5b1e86e8ce5ea95259a6822b6b": {
   "text": "Vires elementorum, in me convenite!",
   "mood": "latin",
   "why": "incantation",
   "model": "gemini-3.8-flash-tts"
  },
  "5b109617af13c3828ece083460f6116b34a5ae2e": {
   "text": "Cor lapidis ter pulsat.",
   "mood": "latin",
   "why": "incantation",
   "model": "gemini-3.8-flash-tts"
  },
  "01482472ab1f1bbdb52501e1713184b543f06f9f": {
   "text": "Quod lapis obliviscitur, aqua meminit.",
   "mood": "latin",
   "why": "incantation",
   "model": "gemini-3.8-flash-tts"
  },
  "b29df989c960d508d67fb28519945dacf3e89844": {
