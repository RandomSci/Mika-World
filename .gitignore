.godot/
*.import.tmp
# Raw Mixamo animation files: not redistributable as raw assets (see ASSETS.md). Import settings ARE tracked.
assets/animations/mixamo/*.fbx
# Runtime screenshots (curated copies live in docs/screenshots)
/screenshots/
assets/animations/mixamo_sword/*.fbx
/.dl_quarantine/
/.env.dev
/.env*
/.backups/
# Song audio stays local until its broadcast/commercial rights are confirmed (see each metadata.json)
assets/audio/music/library/*/*.mp3
assets/audio/music/library/*/*.wav
# Local voice venv (edge-tts) for tools/voice/edge_service.py
/.venv-voice/

# transformation cutscene sources dropped for conversion (tools/transformations/convert.sh)
assets/transformations/incoming/*
!assets/transformations/incoming/.gdignore
